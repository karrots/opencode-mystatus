{
  "name": "opencode-mystatus",
  "version": "1.2.4",
  "description": "Check all your AI subscription quotas in one command. Supports OpenAI, Zhipu AI, Z.ai, Synthetic, Google Antigravity, and GitHub Copilot.",
  "type": "module",
  "main": "dist/plugin/mystatus.js",
  "types": "dist/plugin/mystatus.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin/mystatus.js",
      "types": "./dist/plugin/mystatus.d.ts"
    },
    "./tui": {
      "import": "./dist/plugin/mystatus-tui.js",
      "types": "./dist/plugin/mystatus-tui.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/status.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "quota",
    "status",
    "openai",
    "zhipu",
    "zai",
    "google",
    "antigravity",
    "gemini",
    "claude"
  ],
  "author": "javazys",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbgate/opencode-mystatus.git"
  },
  "bugs": {
    "url": "https://github.com/vbgate/opencode-mystatus/issues"
  },
  "homepage": "https://github.com/vbgate/opencode-mystatus#readme",
  "dependencies": {
    "@opencode-ai/plugin": "^1.15.10",
    "@opencode-ai/sdk": "^1.15.10",
    "@opentui/core": "^0.2.15",
    "@opentui/keymap": "^0.2.15",
    "@opentui/solid": "^0.2.15",
    "solid-js": "^1.9.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
